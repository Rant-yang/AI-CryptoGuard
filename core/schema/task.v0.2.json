{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "fast",
        "deep-java"
      ]
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "enum": [
              "scan",
              "deep_java",
              "quantum_assessment",
              "ai"
            ]
          },
          "status": {
            "enum": [
              "pending",
              "running",
              "completed",
              "skipped",
              "failed",
              "timeout"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "seconds": {
            "type": "number",
            "minimum": 0
          },
          "tool_version": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "status",
          "reason",
          "seconds",
          "tool_version"
        ]
      },
      "minItems": 1
    },
    "quantum_timeline_profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile_version": {"type": "string", "minLength": 1},
        "data_lifetime_years": {"type": ["number", "null"], "minimum": 0, "maximum": 200},
        "migration_lead_years": {"type": ["number", "null"], "minimum": 0, "maximum": 200},
        "threat_horizon_years": {"type": ["number", "null"], "minimum": 0, "maximum": 200},
        "hndl_exposure": {"enum": ["yes", "no", "unknown"]},
        "source": {"enum": ["user-input", "policy", "not-provided"]}
      },
      "required": [
        "profile_version", "data_lifetime_years", "migration_lead_years",
        "threat_horizon_years", "hndl_exposure", "source"
      ]
    },
    "unresolved_deep_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tool": {
            "const": "crysentry"
          },
          "kind": {
            "const": "taint"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "flow": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "file": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "line": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 1
                      },
                      "method": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "file",
                      "line",
                      "method"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sink": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "line": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  },
                  "method": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "file",
                  "line",
                  "method"
                ]
              },
              "path": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "file": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "line": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1
                    },
                    "method": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "file",
                    "line",
                    "method"
                  ]
                },
                "minItems": 0
              },
              "completeness": {
                "enum": [
                  "complete",
                  "source_missing",
                  "partial"
                ]
              }
            },
            "required": [
              "source",
              "sink",
              "path",
              "completeness"
            ]
          }
        },
        "required": [
          "tool",
          "kind",
          "reason",
          "flow"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "mode",
    "languages",
    "stages",
    "unresolved_deep_evidence"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#"
}
